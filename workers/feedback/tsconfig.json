{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "WebWorker"],
		"types": ["@cloudflare/vitest-plugin/types"],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts", "worker-configuration.d.ts"]
}

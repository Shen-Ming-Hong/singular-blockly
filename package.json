{
	"name": "singular-blockly",
	"displayName": "Singular Blockly",
	"description": "Blockly visual programming for Arduino, ESP32, CyberBrick MicroPython, and fischertechnik TXT. Drag-and-drop blocks, live C++/Python code preview, PlatformIO and one-click upload, AI camera blocks, Agent Skills, and 15 languages.",
	"version": "0.92.2",
	"license": "Apache-2.0",
	"engines": {
		"vscode": "^1.126.0",
		"node": ">=22.16.0"
	},
	"preview": true,
	"publisher": "Singular-Ray",
	"icon": "images/icon.png",
	"categories": [
		"Education",
		"Visualization",
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Shen-Ming-Hong/singular-blockly"
	},
	"homepage": "https://github.com/Shen-Ming-Hong/singular-blockly#readme",
	"bugs": {
		"url": "https://blockly-support.singular-ai.org/support"
	},
	"keywords": [
		"arduino",
		"blockly",
		"visual-programming",
		"education",
		"microcontroller",
		"programming",
		"code-generator",
		"drag-and-drop",
		"esp32",
		"micropython",
		"cyberbrick",
		"fischertechnik",
		"platformio",
		"scratch",
		"block-based",
		"stem",
		"robotics",
		"kids",
		"huskylens",
		"no-code"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "singular-blockly.openBlocklyEdit",
				"title": "%command.openBlocklyEdit.title%",
				"category": "Singular Blockly"
			},
			{
				"command": "singular-blockly.previewBackup",
				"title": "%command.previewBackup.title%",
				"category": "Singular Blockly"
			},
			{
				"command": "singular-blockly.checkPlatformioStatus",
				"title": "%command.checkPlatformioStatus.title%",
				"category": "Singular Blockly"
			},
			{
				"command": "singular-blockly.provideFeedback",
				"title": "%command.provideFeedback.title%",
				"category": "Singular Blockly",
				"icon": "$(feedback)"
			},
			{
				"command": "singular-blockly.showMyFeedback",
				"title": "%command.showMyFeedback.title%",
				"category": "Singular Blockly",
				"icon": "$(history)"
			},
			{
				"command": "singular-blockly.stopTxtExecution",
				"title": "%command.stopTxtExecution.title%",
				"category": "Singular Blockly"
			},
			{
				"command": "singular-blockly.txt.installRuntime",
				"title": "%command.installTxtRuntime.title%",
				"category": "Singular Blockly"
			}
		],
		"menus": {
			"issue/reporter": [
				{
					"command": "singular-blockly.provideFeedback"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "singular-blockly-view",
					"title": "Singular Blockly",
					"icon": "images/activitybar.svg"
				}
			]
		},
		"views": {
			"singular-blockly-view": [
				{
					"id": "singular-blockly-view",
					"name": "Singular Blockly",
					"type": "webview"
				}
			]
		},
		"configuration": {
			"title": "Singular Blockly",
			"properties": {
				"singularBlockly.managedRuntime.path": {
					"type": "string",
					"default": "",
					"scope": "machine",
					"markdownDescription": "%singularBlockly.managedRuntime.path.markdownDescription%"
				},
				"singularBlockly.safetyGuard.suppressWarning": {
					"type": "boolean",
					"default": false,
					"description": "%singularBlockly.safetyGuard.suppressWarning.description%"
				},
				"singular-blockly.experimental.blockPacks": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%singular-blockly.experimental.blockPacks.markdownDescription%"
				},
				"singular-blockly.txt.host": {
					"type": "string",
					"default": "192.168.7.2",
					"description": "%singular-blockly.txt.host.description%"
				},
				"singular-blockly.txt.username": {
					"type": "string",
					"default": "ftc",
					"description": "%singular-blockly.txt.username.description%"
				},
				"singular-blockly.txt.remotePath": {
					"type": "string",
					"default": "/tmp/singular_blockly/main.py",
					"description": "%singular-blockly.txt.remotePath.description%"
				},
				"singular-blockly.txt.runtimePort": {
					"type": "number",
					"default": 8080,
					"description": "%singular-blockly.txt.runtimePort.description%"
				},
				"singular-blockly.cyberbrick.uploadSettings": {
					"type": "object",
					"scope": "resource",
					"default": {
						"schemaVersion": 2,
						"pairedDevices": []
					},
					"description": "%singular-blockly.cyberbrick.uploadSettings.description%",
					"properties": {
						"schemaVersion": {
							"type": "number",
							"default": 2
						},
						"primaryDeviceId": {
							"type": "string"
						},
						"pairedDevices": {
							"type": "array",
							"default": [],
							"items": {
								"type": "object"
							}
						}
					}
				}
			}
		},
		"jsonValidation": [
			{
				"fileMatch": "*.sbpack.json",
				"url": "./media/schemas/block-pack.schema.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "node scripts/cleanup-temp-toolbox.js && npm run package && npm run generate:third-party-notices",
		"compile": "webpack",
		"generate:third-party-notices": "node scripts/generate-third-party-notices.js",
		"generate:skill-contract": "node scripts/generate-skill-contract.js",
		"check:skill-contract": "node scripts/generate-skill-contract.js --check",
		"generate:project-skills": "npm run generate:skill-contract && node scripts/generate-project-skill-manifest.js",
		"check:project-skills": "npm run check:skill-contract && node scripts/generate-project-skill-manifest.js --check",
		"check:managed-runtime": "node scripts/managed-runtime/validate-manifest.js",
		"test:managed-runtime:paths": "node scripts/managed-runtime/test-installation.js",
		"test:managed-runtime:evidence": "node scripts/managed-runtime/evidence.test.js",
		"test:managed-runtime:e2e": "npm run compile-tests && node scripts/managed-runtime/test-real-installation.js",
		"test:managed-runtime:vsix": "node scripts/managed-runtime/smoke-vsix.js",
		"test:managed-runtime": "npm run compile-tests && vscode-test --label unit --forbid-only --fail-zero --skip-extension-dependencies --run out/test/services/managedRuntimeManifest.test.js out/test/services/managedRuntimeStorage.test.js out/test/services/managedRuntimeDownloader.test.js out/test/services/managedRuntimeArchive.test.js out/test/services/managedRuntimeInstaller.test.js out/test/services/managedRuntimeService.test.js out/test/services/managedRuntimeCleanup.test.js out/test/services/managedRuntimeInitializationCoordinator.test.js out/test/services/managedRuntimeProgressPresenter.test.js out/test/services/platformioProcess.test.js out/test/services/coreFailureClassifier.test.js out/test/services/coreEnvironmentManager.test.js out/test/services/micropythonUploaderAvailability.test.js out/test/services/arduinoUploader.test.js",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "node scripts/clean-test-output.js && tsc -p . --outDir out",
		"watch-tests": "node scripts/clean-test-output.js && tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"test:bail": "vscode-test --bail",
		"test:coverage": "vscode-test --coverage",
		"test:i18n": "mocha scripts/i18n/*.test.js",
		"test:release": "mocha scripts/release/prepare-release.test.js",
		"test:unit:ci": "vscode-test --label unit --forbid-only --fail-zero --skip-extension-dependencies",
		"test:coverage:ci": "vscode-test --label unit --coverage --coverage-output coverage --coverage-reporter html --coverage-reporter lcov --coverage-reporter text-summary --forbid-only --fail-zero --skip-extension-dependencies",
		"lint": "eslint src",
		"lint:i18n": "eslint scripts/i18n --ext .js --max-warnings=0",
		"lint:release": "eslint scripts/release --ext .js --max-warnings=0",
		"scan:blockly-msg": "node scripts/i18n/scan-blockly-msg.js",
		"validate:i18n": "node scripts/i18n/validate-translations.js --all",
		"validate:i18n:lang": "node scripts/i18n/validate-translations.js",
		"test": "vscode-test --label unit",
		"test:integration": "vscode-test --label integration --forbid-only --fail-zero --skip-extension-dependencies",
		"release:prepare": "node scripts/release/prepare-release.js --verify-files",
		"feedback:types": "wrangler types --config workers/feedback/wrangler.jsonc --env-interface FeedbackEnv workers/feedback/worker-configuration.d.ts",
		"feedback:contracts": "node scripts/feedback/validate-contracts.js",
		"feedback:portal-locales": "node scripts/feedback/generate-portal-locales.js",
		"feedback:portal-locales:check": "node scripts/feedback/generate-portal-locales.js --check",
		"feedback:test": "vitest run --config workers/feedback/vitest.config.mts",
		"feedback:typecheck": "tsc --noEmit -p workers/feedback/tsconfig.json",
		"feedback:dev": "wrangler dev --config workers/feedback/wrangler.jsonc --local",
		"feedback:migrate:local": "wrangler d1 migrations apply singular-blockly-feedback --config workers/feedback/wrangler.jsonc --local",
		"feedback:verify-vsix": "node scripts/feedback/verify-vsix-privacy.js",
		"feedback:package": "vsce package",
		"feedback:verify-vsix:test": "mocha scripts/feedback/verify-vsix-privacy.test.js",
		"feedback:triage-skill:test": "mocha scripts/feedback/validate-triage-skill.test.js",
		"ci:static": "npm run check:project-skills && npm run check:managed-runtime && npm run test:managed-runtime:evidence && npm run compile-tests && npm run compile && npm run lint && npm run lint:i18n && npm run lint:release && npm run validate:i18n && npm run test:i18n && npm run test:release && npm run feedback:portal-locales:check && npm run feedback:contracts && npm run feedback:typecheck && npm run feedback:verify-vsix:test && npm run feedback:triage-skill:test && npm run feedback:test"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@types/mocha": "^10.0.10",
		"@types/node": "~24.19.2",
		"@types/sinon": "^22.0.1",
		"@types/vscode": "~1.125.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "4.0.0",
		"ajv": "^8.20.0",
		"blockly": "^13.4.0",
		"copy-webpack-plugin": "^14.0.0",
		"eslint": "^10.13.0",
		"jpeg-js": "^0.4.4",
		"ovsx": "1.3.0",
		"sinon": "^22.1.0",
		"ts-loader": "^9.6.2",
		"typescript": "^6.0.3",
		"vitest": "^4.1.12",
		"webpack": "^5.112.1",
		"webpack-cli": "^7.2.3",
		"wrangler": "^4.152.0"
	},
	"dependencies": {
		"@blockly/theme-modern": "^13.4.0",
		"@vscode/proxy-agent": "0.45.0",
		"node-ssh": "^13.2.1",
		"tar": "7.5.22"
	},
	"overrides": {
		"sharp": "0.35.5",
		"js-yaml": "^5.4.2",
		"qs": "^6.16.0",
		"serialize-javascript": "^7.1.4",
		"fast-uri": "^3.1.9",
		"diff": ">=8.0.3",
		"flatted": ">=3.4.0",
		"picomatch": "2.3.2",
		"tinyglobby": {
			"picomatch": "4.0.4"
		},
		"fdir": {
			"picomatch": "4.0.4"
		},
		"minimatch@3.1.5": {
			"brace-expansion": "^1.1.18"
		},
		"minimatch@9.0.9": {
			"brace-expansion": "^2.1.7"
		},
		"minimatch@10.2.4": {
			"brace-expansion": "^5.0.12"
		},
		"undici": "^7.30.1",
		"zod": "^4.6.7",
		"@azure/identity": {
			"@azure/msal-node": "^7.1.1"
		},
		"socks": {
			"ip-address": "^10.7.5"
		}
	}
}
